{
  "name": "vscode-pdf-mcp",
  "displayName": "PDF viewer for agents (vscode-pdf-mcp)",
  "description": "A PDF viewer for VS Code that an AI agent can see into: an MCP server and a Claude Code hook report the document, page and selection you are reading.",
  "version": "0.1.0",
  "publisher": "david-wang-0",
  "license": "MIT",
  "author": "David Wang",
  "repository": {
    "type": "git",
    "url": "https://github.com/david-wang-0/vscode-pdf-mcp"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "pdf",
    "mcp",
    "claude",
    "viewer",
    "pdf.js"
  ],
  "main": "./extension/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "vscodePdfMcp.viewer",
        "displayName": "PDF viewer (vscode-pdf-mcp)",
        "selector": [
          {
            "filenamePattern": "*.pdf"
          },
          {
            "filenamePattern": "*.PDF"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "vscodePdfMcp.openExternal",
        "title": "Open in Okular",
        "category": "PDF",
        "icon": "$(link-external)"
      },
      {
        "command": "vscodePdfMcp.synctexForward",
        "title": "show in PDF",
        "category": "SyncTeX"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vscodePdfMcp.openExternal",
          "when": "activeCustomEditorId == vscodePdfMcp.viewer",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "vscodePdfMcp.openExternal",
          "when": "activeCustomEditorId == vscodePdfMcp.viewer"
        },
        {
          "command": "vscodePdfMcp.synctexForward",
          "when": "editorLangId == latex || editorLangId == tex || editorLangId == doctex || resourceExtname == .tex"
        }
      ]
    },
    "configuration": {
      "title": "PDF viewer (vscode-pdf-mcp)",
      "properties": {
        "vscodePdfMcp.externalViewer": {
          "type": "string",
          "default": "okular",
          "description": "Executable for \"Open in Okular\" when the pdf-external-open extension is not installed; it is run with the PDF's absolute path as its only argument."
        },
        "vscodePdfMcp.editCommand": {
          "type": "string",
          "default": "pdf-reader-writer-edit",
          "description": "The edit service every mark is written through: pdf-reader-writer-mcp's `pdf-reader-writer-edit`, looked up on PATH unless this is an absolute path. Marking is off when it cannot be started. The environment variable VSCODE_PDF_MCP_EDIT_COMMAND overrides it."
        },
        "vscodePdfMcp.editArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Arguments for vscodePdfMcp.editCommand."
        },
        "vscodePdfMcp.author": {
          "type": "string",
          "default": "",
          "description": "Author (/T) written into your marks, and the author whose marks you may edit and delete. Empty: your login name."
        },
        "vscodePdfMcp.keys": {
          "type": "object",
          "default": {},
          "markdownDescription": "Shortcuts in the PDF viewer, active when the focus is not in a text field. Keys: `highlight` (default `h`), `underline` (`u`), `squiggly` (`s`), `strikeout` (`x`) apply to the current selection; `note` (`n`) toggles the margin-note tool; `undo` (`ctrl+z`). A value is a key with optional modifiers, e.g. `\"shift+h\"`. Escape always returns to no tool.",
          "properties": {
            "highlight": {
              "type": "string"
            },
            "underline": {
              "type": "string"
            },
            "squiggly": {
              "type": "string"
            },
            "strikeout": {
              "type": "string"
            },
            "note": {
              "type": "string"
            },
            "undo": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "bin": {
    "vscode-pdf-mcp": "mcp/server.js",
    "vscode-pdf-mcp-hook": "bin/hook.js",
    "vscode-pdf-mcp-open": "bin/open.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:webview": "node --test test/webview/run.js",
    "test:integration": "node test/integration/run.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "pdfjs-dist": "5.4.624",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@vscode/test-electron": "3.1.0",
    "playwright-core": "1.64.0"
  }
}
